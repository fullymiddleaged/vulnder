{
  "name": "vulnder",
  "version": "0.1.0",
  "private": true,
  "description": "A stack-aware CVE feed on Cloudflare Workers",
  "license": "Apache-2.0",
  "author": "Pete Salmond (https://github.com/fullymiddleaged)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "tsx scripts/production-config.ts && wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "config:production": "tsx scripts/production-config.ts",
    "deploy:free": "tsx scripts/production-config.ts && wrangler deploy --config wrangler.production.jsonc",
    "deploy:paid": "tsx scripts/production-config.ts && wrangler deploy --env paid --config wrangler.production.jsonc",
    "backfill": "tsx scripts/backfill.ts",
    "check:names": "tsx scripts/check-names.ts",
    "ingest": "tsx scripts/ingest.ts",
    "record-fixtures": "tsx scripts/record-fixtures.ts",
    "seed:remote": "tsx scripts/seed-remote.ts",
    "update-injection-corpus": "tsx scripts/update-injection-corpus.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test && tsc --noEmit -p scripts && tsc --noEmit -p web",
    "lint": "eslint .",
    "types": "wrangler types",
    "build:web": "esbuild web/main.ts --bundle --format=esm --target=es2022 --minify --sourcemap --outfile=public/app.js"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "smol-toml": "^1.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261001.1": true,
    "workerd@1.20261006.1": true
  }
}
