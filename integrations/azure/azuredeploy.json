          "type": "Switch",
          "expression": "@parameters('mode')",
          "runAfter": {
            "Init_next": [
              "Succeeded"
            ]
          },
          "cases": {
            "Defender": {
              "case": "defender",
              "actions": {
                "Hunt_open_CVEs": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "Query": "DeviceTvmSoftwareVulnerabilities | distinct CveId"
                    },
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "https://graph.microsoft.com"
                    }
                  },
                  "runAfter": {}
