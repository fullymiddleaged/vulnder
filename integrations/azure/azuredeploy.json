                  "runAfter": {},
                  "actions": {
                    "Get_page": {
                      "type": "Http",
                      "inputs": {
                        "method": "GET",
                        "uri": "@variables('next')",
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "https://graph.microsoft.com"
                        }
                      },
                      "runAfter": {}
                    },
                    "Merge_page": {
                      "type": "Compose",
                      "inputs": "@union(variables('apps'), body('Get_page')?['value'])",
                      "runAfter": {
                        "Get_page": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Keep_apps": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "apps",
                        "value": "@outputs('Merge_page')"
                      },
                      "runAfter": {
                        "Merge_page": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Next_page": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "next",
                        "value": "@{coalesce(body('Get_page')?['@odata.nextLink'], '')}"
                      },
                      "runAfter": {
                        "Keep_apps": [
                          "Succeeded"
                        ]
                      }
                    }
                  }
                },
                "Four_fields": {
                  "type": "Select",
                  "inputs": {
                    "from": "@take(reverse(sort(variables('apps'), 'deviceCount')), 4000)",
                    "select": {
                      "displayName": "@item()?['displayName']",
                      "version": "@item()?['version']",
                      "publisher": "@item()?['publisher']",
                      "deviceCount": "@item()?['deviceCount']"
                    }
                  },
                  "runAfter": {
                    "Page_through_apps": [
                      "Succeeded"
                    ]
                  }
                },
                "Build_stack": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{parameters('vulnderUrl')}/api/v1/stack",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "inventory": "@body('Four_fields')"
                    }
                  },
                  "runAfter": {
                    "Four_fields": [
                      "Succeeded"
                    ]
                  }
                },
