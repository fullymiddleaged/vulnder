        }
      },
      "triggers": {
        "Every_hour": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Hour",
            "interval": 1
          }
        }
      },
      "actions": {
        "Init_rows": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "rows",
                "type": "array",
                "value": []
              }
            ]
          },
          "runAfter": {}
        },
        "Init_apps": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "apps",
                "type": "array",
                "value": []
              }
            ]
          },
          "runAfter": {
            "Init_rows": [
              "Succeeded"
            ]
          }
        },
        "Init_next": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "next",
                "type": "string",
                "value": "https://graph.microsoft.com/v1.0/deviceManagement/detectedApps"
