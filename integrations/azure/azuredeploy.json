                "Keep_inventory_rows": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "rows",
                    "value": "@body('Rank_inventory')?['rows']"
                  },
                  "runAfter": {
                    "Rank_inventory": [
                      "Succeeded"
                    ]
                  }
                }
              }
            },
            "Stack": {
              "case": "stack",
              "actions": {
                "If_no_stack": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@trim(parameters('stack'))",
                          ""
                        ]
                      }
                    ]
                  },
                  "runAfter": {},
                  "actions": {
                    "No_stack": {
                      "type": "Terminate",
                      "inputs": {
                        "runStatus": "Failed",
                        "runError": {
                          "code": "NoStack",
                          "message": "mode stack needs the stack parameter"
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              }
            }
          },
          "default": {
            "actions": {
              "Unknown_mode": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Failed",
                  "runError": {
                    "code": "UnknownMode",
                    "message": "mode must be defender, intune or stack"
                  }
                },
                "runAfter": {}
              }
            }
          }
        },
        "If_stack": {
          "type": "If",
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@trim(parameters('stack'))",
                    ""
