                            "headers": {
                              "Content-Type": "application/json"
                            },
                            "body": {
                              "cves": "@items('For_each_2000_CVEs')",
                              "days": "@parameters('days')"
                            }
                          },
                          "runAfter": {}
                        },
                        "Merge_CVE_rows": {
                          "type": "Compose",
                          "inputs": "@union(variables('rows'), body('Rank_CVEs')?['rows'])",
                          "runAfter": {
                            "Rank_CVEs": [
                              "Succeeded"
                            ]
                          }
                        },
                        "Keep_CVE_rows": {
                          "type": "SetVariable",
                          "inputs": {
                            "name": "rows",
                            "value": "@outputs('Merge_CVE_rows')"
