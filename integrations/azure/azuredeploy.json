                  }
                },
                "If_any_CVEs": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "greater": [
                          "@length(body('CVE_IDs'))",
                          0
                        ]
                      }
                    ]
                  },
                  "runAfter": {
                    "CVE_IDs": [
                      "Succeeded"
                    ]
                  },
                  "else": {
                    "actions": {}
                  },
                  "actions": {
                    "For_each_2000_CVEs": {
                      "type": "Foreach",
                      "foreach": "@chunk(body('CVE_IDs'), 2000)",
                      "runtimeConfiguration": {
                        "concurrency": {
                          "repetitions": 1
                        }
                      },
                      "runAfter": {},
                      "actions": {
                        "Rank_CVEs": {
                          "type": "Http",
