                  "Succeeded"
                ]
              }
            },
            "Keep_stack_rows": {
              "type": "SetVariable",
              "inputs": {
                "name": "rows",
                "value": "@outputs('Merge_stack_rows')"
              },
              "runAfter": {
                "Merge_stack_rows": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Tag_rows": {
          "type": "Select",
          "inputs": {
            "from": "@variables('rows')",
            "select": "@setProperty(setProperty(setProperty(setProperty(item(), 'timeGenerated', utcNow()), 'runId', workflow()?['run']?['name']), 'mode', parameters('mode')), 'sourceName', parameters('source'))"
