                "greater": [
                  "@length(body('Tag_rows'))",
                  0
                ]
              }
            ]
          },
          "runAfter": {
            "Tag_rows": [
              "Succeeded"
            ]
          },
          "actions": {
            "For_each_200_rows": {
              "type": "Foreach",
              "foreach": "@chunk(body('Tag_rows'), 200)",
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {},
              "actions": {
                "Send_to_Log_Analytics": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@parameters('ingestUrl')",
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": "@items('For_each_200_rows')",
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "https://monitor.azure.com"
                    }
                  },
                  "runAfter": {}
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
