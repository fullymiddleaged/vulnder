// The latest Vulnder run: every CVE affecting the tenant, most urgent first.
let level = (p: string) { case(p == "act", 4, p == "attend", 3, p == "watch", 2, 1) };
let latest = toscalar(Vulnder_CL | where TimeGenerated > ago(1d) | summarize arg_max(TimeGenerated, RunId) | project RunId);
Vulnder_CL
| where TimeGenerated > ago(1d) and RunId == latest
| order by level(Priority) desc, Score desc
| project Cve, CveTitle, Priority, Score, RespondWithinHours, Reasons, Exploited, KevDueDate, Epss, Cvss, Matched, MatchType, Confidence, FixedVersions, Mitigation, Advisory
